<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A-39b: Liquibase-owned copy of the Spring Batch 6.0.4 postgres DDL,
         table-prefixed per service (PRR_BATCH_) for single-writer cleanliness
         (R-34), EXIT_MESSAGE widened to TEXT so CRDB-driver cause chains are
         never truncated.

         LIQUIBASE-SQL-EXCEPTION: this is autogenerated FRAMEWORK DDL owned by
         Spring Batch, not schema this project designs. Hand-transcribing ~9
         tables and 3 sequences into typed tags would fork the framework's own
         schema and make the next Batch upgrade a manual diff, which is the
         vendor-lock the pure-XML rule exists to prevent, not an instance of it.
         Same precedent as CRR 002 and MRR. Every CREATE carries IF NOT EXISTS,
         so a pod SIGKILLed mid-migration re-runs the file safely. -->
    <changeSet id="prr-002-batch-metadata" author="dcre">
        <validCheckSum>ANY</validCheckSum>
        <sqlFile path="db/changelog/2026/08/batch-metadata-prr.sql" splitStatements="true"/>
    </changeSet>

</databaseChangeLog>
